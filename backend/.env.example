# Pepper backend: environment variables

# === REQUIRED ===

# Anthropic API key (server-side only; never sent to the phone)
ANTHROPIC_API_KEY=sk-ant-...

# Bootstrap secret used ONLY to enrol a new device. Each device then gets its own
# token (revocable). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
PEPPER_APP_TOKEN=change-me

# Signing secret for Anthropic webhooks (Console -> Manage -> Webhooks, whsec_...)
# Point the webhook at https://<your-host>/hooks/anthropic
ANTHROPIC_WEBHOOK_SIGNING_KEY=whsec_...

# === OPTIONAL ===

# Model for OT-list reading (the agent's model is set in scripts/setup_agent.py)
# PEPPER_MODEL=claude-opus-5

# Hard spend cap per app-started session, in US cents (e.g. 200 = $2.00)
# PEPPER_SESSION_BUDGET_USD_CENTS=200

# Database (defaults to SQLite in PEPPER_DATA_DIR). Postgres: postgresql+asyncpg://...
# PEPPER_DATABASE_URL=sqlite+aiosqlite:////var/lib/pepper/pepper.db

# Push notifications (APNs .p8 key)
# APNS_KEY_PATH=/var/lib/pepper/AuthKey.p8
# APNS_KEY_ID=ABC123
# APNS_TEAM_ID=DEF456
# APNS_BUNDLE_ID=com.sciscribe.pepper
# APNS_SANDBOX=true

# PEPPER_DATA_DIR=/var/lib/pepper
# PEPPER_AGENT_IDS=/var/lib/pepper/agent_ids.json
# PEPPER_CORS_ORIGINS=https://app.sciscribesolutions.com
