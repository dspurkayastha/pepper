# Pepper Backend Relay — Environment Variables

# === REQUIRED ===

# Anthropic API key (powers Pepper)
ANTHROPIC_API_KEY=sk-ant-...

# Secret for encrypting stored credentials (any strong random string)
PEPPER_SECRET=change-me-to-a-strong-random-string

# Bearer token for iOS app authentication (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
PEPPER_APP_TOKEN=your-app-token-here

# === OPTIONAL: Push Notifications (APNs) ===

# Path to APNs .p8 key file
# APNS_KEY_PATH=/path/to/AuthKey.p8
# APNS_KEY_ID=ABC123
# APNS_TEAM_ID=DEF456
# APNS_BUNDLE_ID=com.sciscribe.pepper
# APNS_SANDBOX=true

# === PATHS ===

# Where to store encrypted credentials and device tokens
# PEPPER_DATA_DIR=/var/lib/pepper

# Path to agent_ids.json from deploy_agent.py
# PEPPER_AGENT_IDS=../agent_ids.json
